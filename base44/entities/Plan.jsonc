{
  "name": "Plan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "billing_period": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "lifetime",
        "free"
      ],
      "default": "free"
    },
    "max_presentations": {
      "type": "number",
      "default": -1
    },
    "max_storage": {
      "type": "number",
      "default": -1
    },
    "can_export_pdf": {
      "type": "boolean",
      "default": false
    },
    "can_use_ai": {
      "type": "boolean",
      "default": false
    },
    "can_use_premium_templates": {
      "type": "boolean",
      "default": false
    },
    "can_sync_devices": {
      "type": "boolean",
      "default": false
    },
    "shows_ads": {
      "type": "boolean",
      "default": true
    },
    "highlight": {
      "type": "boolean",
      "default": false
    },
    "recommended": {
      "type": "boolean",
      "default": false
    },
    "color": {
      "type": "string",
      "default": "#3B82F6"
    },
    "instructions": {
      "type": "string"
    },
    "explanatory_text": {
      "type": "string"
    },
    "duration_days": {
      "type": "number",
      "default": 0
    },
    "manual_renewal": {
      "type": "boolean",
      "default": true
    },
    "admin_notes": {
      "type": "string"
    },
    "order_index": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}