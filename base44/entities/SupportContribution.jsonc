{
  "name": "SupportContribution",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "default": "pix"
    },
    "pix_key_used": {
      "type": "string"
    },
    "payment_date": {
      "type": "string"
    },
    "proof_url": {
      "type": "string"
    },
    "proof_filename": {
      "type": "string"
    },
    "user_message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "confirmed",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    },
    "analyzed_by_user_id": {
      "type": "string"
    },
    "analyzed_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "name"
  ]
}