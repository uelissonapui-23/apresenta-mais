      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "presenter_notes": {
      "type": "string"
    },
    "order_index": {
      "type": "number",
